# Copy to `.env` and fill in real values. Never commit `.env`.

# ---- PostgreSQL ----
POSTGRES_DB=concord
POSTGRES_USER=concord
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Used by sqlx-cli and by the server when run directly on the host. The compose
# `server` service builds its own DATABASE_URL from the POSTGRES_* values above
# (pointed at the `postgres` service), so you do not need to set this for compose.
# Construct from the POSTGRES_* values — don't paste a real password into a
# template that ships in git. `<POSTGRES_PASSWORD>` is a placeholder; percent-
# encode any reserved URL characters (@ : / ? #) in the password.
# DATABASE_URL=postgres://concord:<POSTGRES_PASSWORD>@localhost:5432/concord

# ---- Redis ----
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# Read by the server for the presence store. Optional: if unset, the server
# runs with presence persistence disabled. The compose `server` service builds
# this from the REDIS_* values above (pointed at the `redis` service); set it
# here only when running the server directly on the host. The leading `:` before
# the password is intentional — Redis has no username.
# REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379
# How long a presence entry survives without a heartbeat (crash recovery). Defaults to 60.
# PRESENCE_TTL_SECONDS=60

# ---- Application ----
# These are consumed by both the server and the compose `server` service.

# Host port the compose `server` service publishes (the container always listens
# on 8080). Optional; defaults to 8080.
# SERVER_PORT=8080

# Max Postgres connections in the server pool. Optional; defaults to 10.
# MAX_CONNECTIONS=10

# Used by the server to sign session JWTs. Must be at least 32 bytes.
# Generate with: `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# ---- OAuth providers ----
# Register apps and paste the client credentials here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/api/auth/oauth/github/callback
